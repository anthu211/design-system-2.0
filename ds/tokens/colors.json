  "semantic": {
    "color-accent": {
      "value": "var(--shell-accent)", "raw": "#6360D8",
      "css_var": "--shell-accent",
      "usage": ["cta-primary", "active-nav", "links", "focus-ring"],
      "do": "Use for the single primary action per section and active nav state.",
      "dont": "Never use on destructive actions or as a secondary button color."
    },
    "color-accent-filter": {
      "value": "var(--accent-dark)", "raw": "#504bb8",
      "css_var": "--accent-dark",
      "usage": ["filter-button", "active-filter-pill", "hover-on-accent"],
      "do": "Use exclusively for the Filter CTA and Active Filters pill.",
      "dont": "Never use as a primary CTA color."
    },
    "color-topbar": {
      "value": "#131313", "raw": "#131313",
      "usage": ["topbar-background"],
      "do": "Always fixed at #131313 — never changes with light/dark theme.",
      "dont": "Never override with theme variables or transparency."
    },
    "color-destructive": {
      "value": "#dc2626", "raw": "#dc2626",
      "usage": ["danger-button", "error-border", "error-text", "delete-confirm"],
      "do": "Use for destructive buttons, error borders, and inline field error text.",
      "dont": "Never use for warnings or non-destructive states."
    },
    "color-severity-critical": {
      "raw": "#D12329", "bg": "#F9EEEE", "badge_class": "ds-badge danger",
      "usage": ["severity-badge", "chart-series"]
    },
    "color-severity-high": {
      "raw": "#E15252", "bg": "#FFF0F0", "badge_class": "ds-badge high",
      "usage": ["severity-badge", "chart-series"]
    },
    "color-severity-medium": {
      "raw": "#D98B1D", "bg": "#FEF3C7", "badge_class": "ds-badge warning",
      "usage": ["severity-badge", "chart-series"]
    },
    "color-severity-low": {
      "raw": "#31A56D", "bg": "#EFF7ED", "badge_class": "ds-badge success",
      "usage": ["severity-badge", "chart-series"]
    },
    "color-maturity-weak":     { "raw": "#E15252", "bg": "#FFF0F0", "badge_class": "ds-badge high",    "usage": ["maturity-badge"] },
    "color-maturity-moderate": { "raw": "#D98B1D", "bg": "#FEF3C7", "badge_class": "ds-badge warning", "usage": ["maturity-badge"] },
    "color-maturity-strong":   { "raw": "#31A56D", "bg": "#EFF7ED", "badge_class": "ds-badge success", "usage": ["maturity-badge"] },
    "color-maturity-full":     { "raw": "#1A7D4D", "bg": "#EFF7ED", "badge_class": "ds-badge full",    "usage": ["maturity-badge"] },
    "color-pill-green":  { "border": "#31A56D", "bg": "#EFF7ED", "badge_class": "ds-pill green",  "usage": ["status-pill"] },
    "color-pill-yellow": { "border": "#D98B1D", "bg": "#F2EDDB", "badge_class": "ds-pill yellow", "usage": ["status-pill"] },
    "color-pill-red":    { "border": "#D12329", "bg": "#F9EEEE", "badge_class": "ds-pill red",    "usage": ["status-pill"] },
    "color-pill-orange": { "border": "#E57B1D", "bg": "#F7F6EB", "badge_class": "ds-pill orange", "usage": ["status-pill"] }
  },
